# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
# Virtual environments
.venv
# AegisOps
.env
.env.*
data/corpus/*
data/incidents/*
data/dataset/*
!data/**/.gitkeep
models/
*.gguf
.ruff_cache/
.pytest_cache/
qdrant_storage/
sandbox/logs/
sandbox/.pids/
data/incidents/*
!data/**/.gitkeep
# Les postmortems sont du contenu rédigé, pas des données générées :
# ils doivent être versionnés.
!data/incidents/postmortems/
!data/incidents/postmortems/*.md
data/campaign.log
!data/corpus/sandbox/
!data/corpus/sandbox/*.md
data/checkpoints.sqlite
data/campaign_*.log

# Dataset : les sorties écrites à la main sont suivies, le reste est dérivé
data/dataset/seeds_input.jsonl
data/dataset/seeds.jsonl
data/dataset/raw.jsonl
data/dataset/train.jsonl
data/dataset/val.jsonl
data/dataset/test.jsonl

# Les sorties sont écrites à la main depuis les postmortems. C'est du
# contenu rédigé, au même titre que les postmortems eux-mêmes, et la
# règle `data/dataset/*` plus haut les emportait avec les fichiers
# dérivés. Le dossier doit être désexclu avant ses fichiers : git
# n'entre pas dans un répertoire ignoré, donc une négation sur les
# fichiers seuls n'aurait aucun effet.
!data/dataset/outputs/
!data/dataset/outputs/*.json

# Les captures sont des données primaires et irremplaçables : la
# rétention de Prometheus est de six heures, donc une capture perdue ne
# se régénère pas, elle se refait — et le système d'alors n'existe plus.
# 46 fichiers, 1,8 Mo.
#
# Les captures défectueuses sont suivies elles aussi : ce sont les
# pièces des incidents décrits dans docs/benchmarks.md, et leur santé se
# juge à la lecture (tools/capture_health.py), pas au stockage.
!data/incidents/*.json

# Les captures sont des données primaires et irremplaçables : la
# rétention de Prometheus est de six heures, donc une capture perdue ne
# se régénère pas, elle se refait — et le système d'alors n'existe plus.
# 46 fichiers, 1,8 Mo.
#
# Les captures défectueuses sont suivies elles aussi : ce sont les
# pièces des incidents décrits dans docs/benchmarks.md, et leur santé se
# juge à la lecture (tools/capture_health.py), pas au stockage.
!data/incidents/*.json

# Les captures sont des données primaires et irremplaçables : la
# rétention de Prometheus est de six heures, donc une capture perdue ne
# se régénère pas, elle se refait — et le système d'alors n'existe plus.
# 46 fichiers, 1,8 Mo.
#
# Les captures défectueuses sont suivies elles aussi : ce sont les
# pièces des incidents décrits dans docs/benchmarks.md, et leur santé se
# juge à la lecture (tools/capture_health.py), pas au stockage.
!data/incidents/*.json
